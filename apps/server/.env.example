# Read from apps/server/.env.local via node --env-file-if-exists (copy this file there)
# The one web origin allowed to call the server, e.g. http://localhost:3129 in development
ALLOWED_ORIGIN=
# At least 32 random characters. Keys the recovery code hashes: never change it once codes are handed out
SESSION_SECRET=
# Optional. Key for the in-memory address HMAC (a random one per process is used when empty)
IP_HMAC_KEY=
PROXY_SHARED_SECRET=
# Optional. SQLite file (default apps/server/data/ktd.db)
DB_PATH=
